{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "declaration": true,
    "rootDir": "src", "outDir": "lib", "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
