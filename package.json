{
  "name": "@beibeihk/dsh-agent-observability",
  "version": "0.1.0",
  "description": "Community plugin for event-grounded, privacy-first agent reliability analysis in DeepSeek Harness.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./analysis": { "types": "./lib/analysis.d.ts", "default": "./lib/analysis.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "dsh": { "manifestVersion": 1, "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": "^22.19.0 || >=24.0.0", "dsh": "0.2.0-rc.2" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-commands": { "optional": true }, "@deepseek-ai/dsh-app-boot": { "optional": true } },
  "dependencies": { "@deepseek-ai/schemastery": "3.18.4" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.0.0",
    "fast-check": "^4.0.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "lint": "oxlint src tests scripts examples",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.json",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "npm run build && node scripts/demo.mjs",
    "benchmark": "npm run build && node --expose-gc scripts/benchmark.mjs && node --expose-gc scripts/dispatch-benchmark.mjs",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/beibeihk/dsh-agent-observability.git" },
  "homepage": "https://github.com/beibeihk/dsh-agent-observability#readme",
  "bugs": { "url": "https://github.com/beibeihk/dsh-agent-observability/issues" },
  "author": "Kun Huang <huangkun123huang@163.com>",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "agent-observability", "agent-reliability", "agent-evaluation"],
  "publishConfig": { "access": "public" }
}
